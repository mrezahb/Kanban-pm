          {
            "name": "title",
            "type": "TEXT",
            "nullable": false
          },
          {
            "name": "created_at",
            "type": "TEXT",
            "nullable": false
          },
          {
            "name": "updated_at",
            "type": "TEXT",
            "nullable": false
          }
